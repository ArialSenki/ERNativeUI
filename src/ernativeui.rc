#include <winver.h>

#include "resource.h"
// r148: version numbers come from CMake (ERNATIVEUI_FORK_BUILD, project
// version) through this generated header.
#include "ernativeui_version_rc.h"

ERUI_DEFAULT_INI_RESOURCE RCDATA "../assets/ERNativeUI.ini"

VS_VERSION_INFO VERSIONINFO
FILEVERSION ERUI_RC_VERSION_NUMBER
PRODUCTVERSION ERUI_RC_VERSION_NUMBER
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", ERUI_RC_FILE_DESCRIPTION
            VALUE "FileVersion", ERUI_RC_VERSION_STRING
            VALUE "InternalName", "ERNativeUI"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "ERNativeUI.dll"
            VALUE "ProductName", "ERNativeUI"
            VALUE "ProductVersion", ERUI_RC_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
